{
  "compilerOptions": {
    "target": "ES2020",
    "useUnknownFileExtension": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": [
    "src/**/*",
    "vitest.config.ts",
    "tests/**/*.{ts,tsx}"
  ],
  "exclude": ["node_modules"]
}